# ---- Groq LLM ----
GROQ_API_KEY=gsk_your_key_here
# Groq's standard general-purpose model. Swap to openai/gpt-oss-20b for a
# faster/cheaper reasoning-capable alternative if you need it.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1024

# ---- Storage ----
CHROMA_PERSIST_DIR=./storage/chroma_db
CHUNK_STORE_PATH=./storage/chunk_store.json
BM25_INDEX_PATH=./storage/bm25_index.pkl
UPLOAD_DIR=./storage/uploads

# ---- Embedding & reranking models (served via fastembed / ONNX, no torch) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ---- Chunking ----
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# ---- Hybrid retrieval ----
TOP_K_DENSE=15
TOP_K_BM25=15
RRF_K=60
TOP_K_RERANK_CANDIDATES=10
TOP_K_FINAL=5

# ---- Citation verification ----
CITATION_VERIFIED_THRESHOLD=0.30
CITATION_WEAK_THRESHOLD=0.15

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
